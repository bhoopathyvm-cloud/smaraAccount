<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox off for local debug/profile: flutter_secure_storage's
	     Keychain writes need a keychain-access-groups entitlement whose
	     $(AppIdentifierPrefix) only resolves under real Apple Developer
	     code signing, which isn't configured for "Sign to Run Locally."
	     Release.entitlements enables the sandbox for Mac App Store
	     builds. Revisit aligning this file once a real Team is routine
	     for local flutter run -d macos (macos-app-store-sandbox
	     design.md Decision 3). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Required by file_picker (ofx-transaction-import): its macOS plugin
	     checks for this entitlement key before opening NSOpenPanel even
	     though App Sandbox is off above - without it, pickFiles() returns
	     a FlutterError("ENTITLEMENT_NOT_FOUND") instead of showing the
	     dialog. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
