<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug/Profile builds are signed with the team (Apple Development
	     certificate + Mac development profile, so this Mac must be a
	     registered development device). That gives them an application
	     identifier, which the data-protection keychain needs: the TLS
	     identity lives there (os-provided-encryption), so the legacy
	     keychain's per-signature "allow access" dialogs no longer block
	     the handshake. keychain-access-groups is what makes Xcode embed
	     the profile; it stays out of Release.entitlements (App Store
	     rejection 90285), where the distribution profile already supplies
	     the application identifier. App Sandbox stays off for local
	     debug/profile; Release.entitlements enables it. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.smaraaccounting.smaraAccounting</string>
	</array>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Linked devices / join-by-code: outbound TLS to peers (and Bonjour
	     browse callbacks) when sandbox is later aligned with Release. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required by file_picker (ofx-transaction-import): its macOS plugin
	     checks for this entitlement key before opening NSOpenPanel even
	     though App Sandbox is off above - without it, pickFiles() returns
	     a FlutterError("ENTITLEMENT_NOT_FOUND") instead of showing the
	     dialog. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
